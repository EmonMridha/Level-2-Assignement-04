model PropertyImage {
    id        String  @id @default(uuid())
    url       String
    publicId  String?
    altText   String?
    order     Int     @default(0) // 👈 renamed
    isPrimary Boolean @default(false)

    propertyId String
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@index([propertyId])
    @@map("property_images")
}
